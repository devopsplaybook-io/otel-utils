{
  "name": "@devopsplaybook.io/otel-utils",
  "version": "1.14.2",
  "description": "Utility to simplify integration with Open Telemetry",
  "keywords": [
    "Open",
    "Telemetry",
    "Traces",
    "Logs",
    "Metrics"
  ],
  "license": "ISC",
  "author": "Didier Hoarau",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopsplaybook-io/otel-utils.git"
  },
  "homepage": "https://github.com/devopsplaybook-io/otel-utils#readme",
  "bugs": {
    "url": "https://github.com/devopsplaybook-io/otel-utils/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "lint": "oxlint index.ts src && prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/id-generator-aws-xray": "^3.0.1",
    "@opentelemetry/otlp-exporter-base": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
